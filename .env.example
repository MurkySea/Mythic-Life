# Required: Supabase browser/session client
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required for privileged server-only storage operations
SUPABASE_SERVICE_ROLE_KEY=

# Required for scheduled companion outreach
CRON_SECRET=

# Optional second access layer
SITE_PASSWORD=
GATE_COOKIE_SECRET=
ALLOWED_IPS=

# Companion generation (xAI/Grok)
GROK_API_KEY=
GROK_CHAT_MODEL=
XAI_COMPANION_MODEL=
XAI_IMAGE_MODEL=

# Health/rhythm companion service
MYTHIC_DATA_URL=
MYTHIC_DATA_SECRET=

# Web Push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com

# Optional geolocation ingestion override; falls back to CRON_SECRET
GEO_SECRET=
